function LookupEntity(const Name: string; out Value: string): Boolean;
var
  Lo, Hi, Mid, Cmp: Integer;
begin
  Lo := Low(Entities);
  Hi := High(Entities);
  while Lo <= Hi do
  begin
    Mid := (Lo + Hi) div 2;
    Cmp := CompareStr(Entities[Mid].Name, Name);
    if Cmp = 0 then
    begin
      Value := Entities[Mid].Value;
      Exit(True);
    end;
    if Cmp < 0 then
      Lo := Mid + 1
    else
      Hi := Mid - 1;
  end;
  Value := '';
  Result := False;
end;

end.
