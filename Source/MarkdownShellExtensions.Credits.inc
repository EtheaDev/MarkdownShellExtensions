{ Credits and license of the About box; the copyright ends with the year of the
  module (exe or dll) that shows it, so it never needs a yearly update }
function CreditsText: string;
var
  LDate: TDateTime;
  LYear, LMonth, LDay: Word;
begin
  if not FileAge(GetModuleName(HInstance), LDate) then
    LDate := Now;
  DecodeDate(LDate, LYear, LMonth, LDay);
  Result := Format(CREDITS_TEXT, [LYear]);
end;
